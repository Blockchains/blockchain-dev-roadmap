{
  "$schema": "https://raw.githubusercontent.com/Blockchains/.github/main/docs/blocks.schema.json",
  "schema_version": "1.0",
  "name": "blockchain-dev-roadmap",
  "repo": "Blockchains/blockchain-dev-roadmap",
  "summary": "Curated 2026 developer path from zero to shipping production smart contracts in 13 stages; every stage links concepts, primary docs, a runnable lab and a free tool.",
  "kind": [
    "docs",
    "dataset"
  ],
  "stability": "stable",
  "license": "MIT AND CC-BY-4.0",
  "entrypoints": [
    {
      "type": "file",
      "name": "README.md",
      "ref": "README.md",
      "usage": "https://raw.githubusercontent.com/Blockchains/blockchain-dev-roadmap/main/README.md"
    }
  ],
  "inputs": [],
  "outputs": [
    {
      "name": "stages",
      "type": "Markdown",
      "description": "each item links to a lab, a tool or a Blockchain Lab explainer"
    }
  ],
  "deps": [
    "none"
  ],
  "compatible_with": [
    {
      "repo": "Blockchains/blockchainlab-labs",
      "how": "hands-on labs linked from each item"
    },
    {
      "repo": "Blockchains/blockchainlab-tools",
      "how": "tools linked from each item"
    },
    {
      "repo": "Blockchains/blockchain-interview-questions",
      "how": "companion guide"
    }
  ],
  "tests": {
    "command": "lychee README.md   # link check, see .github/workflows/links.yml",
    "ci": ".github/workflows/links.yml",
    "network": true
  },
  "docs": {
    "readme": "README.md",
    "agents": "AGENTS.md",
    "llms": "llms.txt"
  }
}
